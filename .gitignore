# Segredos
.env
config/.env
# Chave de service account do Veo — entra no build via GitHub secret (GCP_SA_KEY),
# NUNCA versionada. O CI a grava aqui só na hora de empacotar.
packaging/default_config/veo_sa.json
**/veo_sa.json

# Estado de trabalho do pipeline por produto (copies, prompts, formatos, status, cache)
config/products/**/output/
products/*/output/

# Imagens de criativo geradas (dado precioso, fora do git — como o antigo output/criativos)
gerados/

# Python
__pycache__/
*.pyc

# Logs
*.log

# Empacotamento (PyInstaller / Inno Setup)
build/
dist/
packaging/build/
packaging/dist/
packaging/Output/
AdsExpress-Setup-*.exe
Ads Express *.dmg
# App buildado direto na pasta do projeto (clicável, com ícone) — não versionar
Ads Express (*)/
Ads Express (*)*/
*.spec.bak
.venv/
venv/

# Entregas de cliente (binários grandes, ficam só local)
entregas/
Entregas Finais/

# Node
node_modules/

# Sistema
.DS_Store
Thumbs.db

# Deploy local: atalho gerado (contém caminhos absolutos da máquina)
*.lnk
deploy_local/icone.ico

# Vídeo UGC
videos/
config/avatares/*/referencia/
config/avatares/*/voz/*.wav
avatares/*/referencia/
avatares/*/voz/*.wav

# Influenciadores (fotos de pessoas reais não vão pro git)
config/influenciadores/*/referencia/
influenciadores/*/referencia/
